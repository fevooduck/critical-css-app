{
  "name": "critical-css-generator",
  "version": "1.0.0",
  "description": "Critical CSS Generator with multiple viewport support",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "NODE_OPTIONS='--max-http-header-size=32768 --no-deprecation' nodemon server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "critical": "^5.0.1",
    "cssnano": "^7.1.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "postcss": "^8.5.6",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-safe-parser": "^7.1.0",
    "puppeteer": "^25.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "vite": "^5.0.0"
  }
}
